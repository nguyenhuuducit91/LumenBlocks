>
  <style>
    .lmb-notification__item{border-radius:123px !important;background-color:#123456 !important;background-attachment:fixed;background-image:url(columnBackgroundMediaUrl);background-position:columnBackgroundPosition;background-repeat:columnBackgroundRepeat;background-size:columnBackgroundSize;background-blend-mode:columnBackgroundImageBlendMode;padding-right:100px !important}.lmb-notification__item:before{background-color:#123456 !important;opacity:12.3}.lmb-notification__close-button svg{fill:#123456 !important}.lmb-notification__icon svg:not(.lmb-custom-icon){color:#123456 !important}.lmb-notification__icon{margin-left:auto !important;margin-right:auto !important;height:123px !important;width:123px !important;opacity:123 !important;margin-bottom:123px !important}.lmb-notification__icon .lmb-icon-inner-svg,.lmb-notification__icon .lmb-icon-inner-svg svg{width:123px !important;height:123px !important}.lmb-notification__icon .lmb-icon-inner-svg{color:#123456 !important;transform:rotate(123deg) !important}@media screen and (min-width:768px){.lmb-notification__close-button{width:123px;height:123px}}@media screen and (max-width:1025px){.lmb-notification__item{background-image:url(columnTabletBackgroundMediaUrl);background-position:columnTabletBackgroundPosition;background-repeat:columnTabletBackgroundRepeat;background-size:columnTabletBackgroundSize}.lmb-notification__item:before{opacity:12.3}.lmb-notification__icon{margin-left:auto !important;margin-right:auto !important;height:123px !important;width:123px !important}}@media screen and (min-width:768px) and (max-width:1025px){.lmb-notification__close-button{width:123px;height:123px}.lmb-notification__icon .lmb-icon-inner-svg,.lmb-notification__icon .lmb-icon-inner-svg svg{width:123px !important;height:123px !important}.lmb-notification__icon{margin-bottom:123px !important}}@media screen and (max-width:768px){.lmb-notification__item{background-image:url(columnMobileBackgroundMediaUrl);background-position:columnMobileBackgroundPosition;background-repeat:columnMobileBackgroundRepeat;background-size:columnMobileBackgroundSize}.lmb-notification__item:before{opacity:12.3}.lmb-notification__close-button{width:123px;height:123px}.lmb-notification__icon{margin-left:auto !important;margin-right:auto !important;height:123px !important;width:123px !important;margin-bottom:123px !important}.lmb-notification__icon .lmb-icon-inner-svg,.lmb-notification__icon .lmb-icon-inner-svg svg{width:123px !important;height:123px !important}}.lmb-notification__icon .lmb-icon-inner-svg,.lmb-notification__icon .lmb-icon-inner-svg svg *{color:#123456 !important;fill:#123456 !important}
